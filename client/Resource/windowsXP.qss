QWidget#ribbonBar{
    background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
                               stop:0 #DFE8F5,
                               stop:0.2 #D1DFF0,
                               stop:0.21 #C7D8ED,
                               stop:1 #E3F4FF);
                               border-radius:6px;
}
QWidget#tabBarWidget{
    background-color:#BFDBFF;
}
/* ========== 1. 隐藏QTabWidget原生边框和分割线 ========== */
QTabWidget {
    background-color: transparent;
}

QTabWidget::pane {
    border: 1px solid #b8cfe8;
    background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
                               stop:0 #DFE8F5,
                               stop:0.03 #D1DFF0,
                               stop:0.031 #C7D8ED,
                               stop:1 #E3F4FF);
                               border-radius:6px;
    margin: 0px; /* 取消标签和内容区的间距 */
    margin-right:2px;
    margin-left:2px;
    top:-1px;
    border-top:1px solid #b8cfe8;
    border-radius:6px;
}

/* ========== 2. 自定义TabBar背景（和你的Ribbon渐变完全一致） ========== */
QTabBar {
    background: transparent;
    border:0px;
    border-bottom: 1px solid #b8cfe8;
    padding: 0px;
    border-radius:6px;
}

/* ========== 3. 自定义单个Tab标签（关键！实现一体化效果） ========== */
QTabBar::tab {
    /* 背景：选中时白色，未选中时透明（露出背景栏渐变） */
    background-color: transparent;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-height: 30px;
    padding-bottom:8px;

}

/* 选中状态：标签变白色，视觉上“融入”下方内容区 */
QTabBar::tab:selected {
   padding: 6px 16px;
    margin-left: 6px;
    border: 1px solid #b8cfe8;
    border-bottom:0px;
    background-color: #DFE8F5;
    border-color: #a8c7e8;

}

/* 未选中hover状态：轻微高亮，不破坏整体感 */
QTabBar::tab:hover:!selected {
    background-color: rgba(255,255,255, 0.3);
}

ZToolButton#tabAction{
    background: transparent;
    border: none;
    padding: 4px;
}
ZToolButton#tabAction:hover {
    background-color: #a8c7e8;
}
ZToolButton#tabAction:pressed {
    background-color: #7fb3e0;
}
QFrame#category{
    border: 1px solid #BACAD9;
    border-radius:6px;
}
QLabel#categoryLabel{
    background-color:#C1D9F1;
    border: none;
    border-radius:0px;
}
CFramelessWindowBase{
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
}
QWidget#TitleBar{
    background-color: #f6f7f9;
    border-bottom: 1px solid #dcdcdc;
}
QPushButton#btnMin,
QPushButton#btnMax,
QPushButton#btnClose,
QPushButton#btnNomal{
    background: transparent;
    border:0px;
    padding: 6px;
}
QPushButton#btnMin:hover,
QPushButton#btnMax:hover,
QPushButton#btnClose:hover,
QPushButton#btnNomal:hover{
    background-color: #e5e6e8;
    border-radius:4px;
}
QPushButton#btnMin{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Min.svg);
}
QPushButton#btnMax{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Max.svg);
}
QPushButton#btnClose{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Close.svg);
}
QPushButton#btnNomal{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Normal.svg);
    }

/* ========== 菜单栏 ========== */
QMenuBar#appMenuBar{
    background-color: #DFE8F5;
    border-bottom: 1px solid #b8cfe8;
    spacing: 2px;
}
QMenuBar#appMenuBar::item{
    background: transparent;
    padding: 4px 12px;
    border-radius: 4px;
}
QMenuBar#appMenuBar::item:selected{
    background-color: #a8c7e8;
}
QMenuBar#appMenuBar::item:pressed{
    background-color: #7fb3e0;
}
QMenu{
    background-color: #ffffff;
    border: 1px solid #b8cfe8;
    border-radius: 4px;
    padding: 4px;
}
QMenu::item{
    padding: 6px 24px;
    border-radius: 4px;
}
QMenu::item:selected{
    background-color: #DFE8F5;
}

/* ========== 登录/用户管理对话框 ========== */
QDialog#loginDialog,
QDialog#userMgmtDialog{
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    border-radius: 6px;
}
QWidget#loginTitleBar{
    background-color: #f6f7f9;
    border-bottom: 1px solid #dcdcdc;
}
QFrame#loginFormFrame{
    background-color: #ffffff;
}
QLineEdit{
    border: 1px solid #c4d0dc;
    border-radius: 4px;
    padding: 2px 6px;
    background-color: #ffffff;
    selection-background-color: #a8c7e8;
}
QLineEdit:focus{
    border: 1px solid #7fb3e0;
}
QComboBox{
    border: 1px solid #c4d0dc;
    border-radius: 4px;
    padding: 2px 6px;
    background-color: #ffffff;
}
QComboBox::drop-down{
    border: 0px;
    width: 20px;
}
QComboBox QAbstractItemView{
    border: 1px solid #c4d0dc;
    selection-background-color: #a8c7e8;
    outline: 0;
}
QPushButton#loginBtn{
    background-color: #4a90d9;
    color: #ffffff;
    border: 0px;
    border-radius: 4px;
    padding: 4px 12px;
}
QPushButton#loginBtn:hover{
    background-color: #5ba0e9;
}
QPushButton#loginBtn:pressed{
    background-color: #3a80c9;
}
QPushButton#loginCancelBtn{
    background-color: #e5e6e8;
    color: #333333;
    border: 1px solid #c4d0dc;
    border-radius: 4px;
    padding: 4px 12px;
}
QPushButton#loginCancelBtn:hover{
    background-color: #d5d6d8;
}
QPushButton#loginCancelBtn:pressed{
    background-color: #c5c6c8;
}

/* ========== 表格 ========== */
QTableWidget{
    background-color: #ffffff;
    alternate-background-color: #f5f8fc;
    gridline-color: #e0e8f0;
    border: 1px solid #c4d0dc;
    border-radius: 4px;
}
QHeaderView::section{
    background-color: #DFE8F5;
    padding: 4px;
    border: 0px;
    border-right: 1px solid #c4d0dc;
    border-bottom: 1px solid #c4d0dc;
    font-weight: bold;
}
QTableWidget::item:selected{
    background-color: #a8c7e8;
    color: #000000;
}

