QWidget#ribbonBar{
    background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
                               stop:0 #DFE8F5,
                               stop:0.2 #D1DFF0,
                               stop:0.21 #C7D8ED,
                               stop:1 #E3F4FF);
                               border-radius:6px;
}
QWidget#tabBarWidget{
    background-color:#BFDBFF;
}
/* ========== 1. 隐藏QTabWidget原生边框和分割线 ========== */
QTabWidget#mainTab,
QTabWidget#tabWidgetLibrary{
    background-color: transparent;
}

QTabWidget::pane {
    border: 1px solid #b8cfe8;
    background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
                               stop:0 #DFE8F5,
                               stop:0.03 #D1DFF0,
                               stop:0.031 #C7D8ED,
                               stop:1 #E3F4FF);
                               border-radius:6px;
    margin: 0px; /* 取消标签和内容区的间距 */
    margin-right:2px;
    margin-left:2px;
    top:-1px;
    border-top:1px solid #b8cfe8;
    border-radius:6px;
}
QTabBar#centralTabWidgetBar::tab {
    height: 30px;
    Width:  80px;
}
/* 选中状态：标签变白色，视觉上“融入”下方内容区 */
QTabBar#centralTabWidgetBar::tab{
background-color: #DFE8F5;
}
/* 未选中hover状态：轻微高亮，不破坏整体感 */
QTabBar#centralTabWidgetBar::tab:!selected{
border: 1px solid #b8cfe8;
background-color: #DFE8F5;
background-color: rgba(255,255,255,100);
border-color: #a8c7e8;
}
/* ========== 2. 自定义TabBar背景（和你的Ribbon渐变完全一致） ========== */
QTabBar#mainTabBar,
QTabBar#tabWidgetLibraryBar{
    background: transparent;
    border:0px;
    border-bottom: 1px solid #b8cfe8;
    padding: 0px;
    border-radius:6px;
}

/* ========== 3. 自定义单个Tab标签（关键！实现一体化效果） ========== */
QTabBar#mainTabBar::tab,
QTabBar#tabWidgetLibraryBar::tab{
    /* 背景：选中时白色，未选中时透明（露出背景栏渐变） */
    background-color: transparent;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    height: 30px;
    padding-bottom:8px;

}

/* 选中状态：标签变白色，视觉上“融入”下方内容区 */
QTabBar#mainTabBar::tab:selected,
QTabBar#tabWidgetLibraryBar::tab:selected{
   padding: 6px 16px;
    margin-left: 6px;
    border: 1px solid #b8cfe8;
    border-bottom:0px;
    background-color: #DFE8F5;
    border-color: #a8c7e8;

}

/* 未选中hover状态：轻微高亮，不破坏整体感 */
QTabBar#mainTabBar::tab:hover:!selected,
QTabBar#tabWidgetLibraryBar::tab:hover:!selected{
    background-color: rgba(255,255,255, 0.3);
}

ZToolButton#tabAction{
    background: transparent;
    border: none;
    padding: 4px;
}
ZToolButton#tabAction:hover {
    background-color: #a8c7e8;
}
ZToolButton#tabAction:pressed {
    background-color: #7fb3e0;
}
QFrame#category{
    border: 1px solid #BACAD9;
    border-radius:6px;
}
QLabel#categoryLabel{
    background-color:#C1D9F1;
    border: none;
    border-radius:0px;
}

QPushButton{
background:qlineargradient(x1:0,y1:0,x2:0,y2:1,
                           stop:0 #E1ECF9,
                           stop:0.4 #D0E0F4,
                           stop:0.401 #BCD4F1,
                           stop:1 #D3EBFB);
   border: 1px solid #537AAC;
   border-radius:3px;
   min-height:25px;
   min-Width:80px;
}
QPushButton:hover{
   border: 1px solid #FFF3CC;
}
CFramelessWindowBase{
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
}
QWidget#DialogTitleBar{
border-top-left-radius: 15px;
border-top-right-radius: 15px;
    background-color: #f6f7f9;
    border-bottom: 1px solid #dcdcdc;
}
QPushButton#btnMin,
QPushButton#btnMax,
QPushButton#btnClose,
QPushButton#btnNomal{
    background: transparent;
    border:0px;
    padding: 6px;
    min-height:20px;
    min-Width:20px;
    border-radius:0px;
}
QPushButton#btnMin:hover,
QPushButton#btnMax:hover,
QPushButton#btnClose:hover,
QPushButton#btnNomal:hover{
    border: 0px;
}
QPushButton#btnMin:hover{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Min_Hover.svg);
}
QPushButton#btnMax:hover{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Max_Hover.svg);
}
QPushButton#btnClose:hover{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Close_Hover.svg);
}
QPushButton#btnNomal:hover{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Normal_Hover.svg);
}
QPushButton#btnMin{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Min.svg);
}
QPushButton#btnMax{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Max.svg);
}
QPushButton#btnClose{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Close.svg);
}
QPushButton#btnNomal{
    image:url(:/Resource/Resource/TitleBarIcon/Titlebar_Normal.svg);
}
QDialog{
    background-color: #bfdbff;
    border-radius:15px;
}
/* ========== 登录/用户管理对话框 ========== */
QDialog#loginDialog,
QDialog#userMgmtDialog{
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
    border-radius: 6px;
}
QWidget#loginTitleBar{
    background-color: #f6f7f9;
    border-bottom: 1px solid #dcdcdc;
}
QFrame#loginFormFrame{
    background-color: #ffffff;
    border: 1px solid #b0b0b0;
}
